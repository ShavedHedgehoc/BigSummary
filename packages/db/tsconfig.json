{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ESNext"
        ],
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "emitDeclarationOnly": true,
        /* 🌟 СОВРЕМЕННАЯ НАСТРОЙКА ПУТЕЙ ДЛЯ КЛИЕНТА PRISMA */
        "paths": {
            "./generated/client": [
                "./src/generated/index.d.ts"
            ]
        }
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}