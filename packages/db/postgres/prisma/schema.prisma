generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model api_errors {
  id        Int      @id @default(autoincrement())
  dto       String?  @db.VarChar(255)
  message   String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model apparatuses {
  id    Int    @id @default(autoincrement())
  value String @unique @db.VarChar(255)

  records records[]
}

model bases {
  id      Int     @id @default(autoincrement())
  code    String  @unique @db.VarChar(255)
  marking String? @db.VarChar(255)
  boils   boils[]
}

model boils {
  id                    Int             @id @default(autoincrement())
  value                 String          @unique @db.VarChar(255)
  base_id               Int?
  letter                String?         @db.VarChar(255)
  year                  Decimal?        @db.Decimal
  number                Decimal?        @db.Decimal
  plant_id              Int?
  bases                 bases?          @relation(fields: [base_id], references: [id], onDelete: NoAction)
  histories             histories[]
  semi_products         semi_products[] 
  records               records[]       @relation("MainBoil")
  records_organic_bases records[]       @relation("OrganicBaseRelation")
  records_water_bases   records[]       @relation("WaterBaseRelation")
  plants                plants?         @relation(fields: [plant_id], references: [id])

  @@index([plant_id, year(sort: Desc), letter(sort: Desc), number(sort: Desc), id, value, base_id])
  @@index([base_id], map: "idx_boils_base_id")
  @@index([plant_id], map: "idx_boils_plant_id")
}

model cans {
  id      Int       @id @default(autoincrement())
  value   String    @unique @db.VarChar(255)
  records records[]
}

model conveyors {
  id      Int       @id @default(autoincrement())
  value   String    @unique @db.VarChar(255)
  barcode String?   @db.VarChar(13)
  records records[]
}

model docs {
  id        Int       @id @default(autoincrement())
  plantId   Int?
  date      DateTime  @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  plants    plants?   @relation(fields: [plantId], references: [id], onDelete: Cascade)
  records   records[]

  @@index([plantId], map: "idx_docs_plantid")
  @@index([plantId, date], map: "idx_docs_plantid_date")
}

model employees {
  id             Int              @id @default(autoincrement())
  name           String           @unique @db.VarChar(255)
  barcode        String           @unique @db.VarChar(255)
  occupationId   Int?
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)
  occupations    occupations?     @relation(fields: [occupationId], references: [id], onDelete: Cascade)
  histories      histories[]  
}

model histories {
  id            Int            @id @default(autoincrement())
  record_id     Int?
  boil_id       Int?
  historyTypeId Int?
  userId        Int?
  employeeId    Int?
  note          String?        @db.VarChar(255)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)
  note_id       Int?
  plant_id      Int?
  boils         boils?         @relation(fields: [boil_id], references: [id], onDelete:Restrict)
  employees     employees?     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  history_types history_types? @relation(fields: [historyTypeId], references: [id], onDelete: Cascade)
  records       records?       @relation(fields: [record_id], references: [id], onDelete:Restrict)
  users         users?         @relation(fields: [userId], references: [id], onDelete:Restrict)
  notes         notes?         @relation(fields: [note_id], references: [id], onDelete: Cascade)

  @@index([record_id, createdAt], map: "idx_hist_record_createdat")
  @@index([boil_id, createdAt, id, record_id, historyTypeId, userId, employeeId, note, note_id, plant_id, updatedAt], map: "idx_histories_boil_createdat_include")
  @@index([boil_id], map: "idx_histories_boil_id")
  @@index([employeeId], map: "idx_histories_employee_id")
  @@index([historyTypeId], map: "idx_histories_history_type_id")
  @@index([note_id], map: "idx_histories_note_id")
  @@index([plant_id], map: "idx_histories_plant_id")
  @@index([record_id, createdAt], map: "idx_histories_record_createdat")
  @@index([record_id], map: "idx_histories_record_id")
  @@index([record_id, createdAt, id, boil_id, historyTypeId, userId, employeeId, note_id, plant_id, updatedAt], map: "idx_histories_recordid_createdat")
  @@index([userId], map: "idx_histories_user_id")
}

model history_types {
  id          Int         @id @default(autoincrement())
  value       String      @unique @db.VarChar(255)
  description String      @unique @db.VarChar(255)
  for_boil    Boolean?
  histories   histories[]
}

model marking_sample {
  id                 Int                  @id @default(autoincrement())
  value              String               @unique @db.VarChar(255)
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(6)
  record_regulations record_regulations[]
  regulations        regulations[]
}

model notes {
  id        Int         @id @default(autoincrement())
  value     String?     @db.VarChar(255)
  histories histories[]
}

model occupations {
  id          Int         @id @default(autoincrement())
  value       String      @unique @db.VarChar(255)
  description String      @unique @db.VarChar(255)
  employees   employees[]
}

model plants {
  id            Int             @id @default(autoincrement())
  value         String          @unique @db.VarChar(255)
  abb           String?         @db.VarChar(10)
  docs          docs[]
  user_settings user_settings[]
  boils         boils[]
}

model products {
  id            Int             @id @default(autoincrement())
  code1C        String          @unique @db.VarChar(255)
  marking       String          @db.VarChar(255)
  name          String?         @db.VarChar(255)
  serieId       Int?
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(6)
  series        series?         @relation(fields: [serieId], references: [id], onDelete: Cascade)
  regulations   regulations[]
  semi_products semi_products[]

  records records[]
}

model record_counters {
  id            Int      @id @default(autoincrement())
  record_id     Int?
  task_uid      String?  @unique @db.VarChar(255)
  counter_value Int
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
  records       records? @relation(fields: [record_id], references: [id], onDelete: Cascade)
}

model record_regulations {
  id                    Int             @id @default(autoincrement())
  record_id             Int?
  org_base_min_weight   Decimal?        @db.Decimal
  org_base_max_weight   Decimal?        @db.Decimal
  water_base_min_weight Decimal?        @db.Decimal
  water_base_max_weight Decimal?        @db.Decimal
  per_box               Int?
  box_per_row           Int?
  row_on_pallet         Int?
  gasket                String?         @db.VarChar(255)
  seal                  Boolean?
  technician_note       String?         @db.VarChar(255)
  packaging_note        String?         @db.VarChar(255)
  marking_sample_id     Int?
  inc_color             String?         @db.VarChar(255)
  marking_feature       String?         @db.VarChar(255)
  createdAt             DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @db.Timestamptz(6)
  marking_sample        marking_sample? @relation(fields: [marking_sample_id], references: [id], onDelete: NoAction)
  records               records?        @relation(fields: [record_id], references: [id], onDelete: Cascade)

  @@index([marking_sample_id], map: "idx_record_regulations_marking_sample_id")
  @@index([record_id], map: "idx_record_regulations_record_id")
}

model records {
  id                 Int                  @id @default(autoincrement())
  doc_id             Int?
  productId          Int?
  boilId             Int?
  apparatusId        Int?
  canId              Int?
  conveyorId         Int?
  plan               Int
  bbf                String               @db.VarChar(255)
  note               String               @db.VarChar(1024)
  workshopId         Int?
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(6)
  isSet              Boolean?
  organic_base_id    Int?
  water_base_id      Int?
  dm                 String               @default("-") @db.VarChar(48)
  histories          histories[]
  record_counters    record_counters[]
  record_regulations record_regulations[]
  boils              boils?               @relation("MainBoil", fields: [boilId], references: [id], onDelete: Cascade)
  water_bases        boils?               @relation("WaterBaseRelation", fields: [water_base_id], references: [id], onDelete: Restrict)
  organic_bases      boils?               @relation("OrganicBaseRelation", fields: [organic_base_id], references: [id], onDelete: Restrict)
  conveyors          conveyors?           @relation(fields: [conveyorId], references: [id], onDelete: Restrict)
  docs               docs?                @relation(fields: [doc_id], references: [id], onDelete: Cascade)
  workshops          workshops?           @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  products           products?            @relation(fields: [productId], references: [id], onDelete: Cascade)

  apparatuses   apparatuses?    @relation(fields: [apparatusId], references: [id], onDelete: Cascade)
  cans          cans?           @relation(fields: [canId], references: [id], onDelete: Cascade)
  semi_products semi_products[]

  @@index([apparatusId], map: "idx_records_apparatusid")
  @@index([boilId], map: "idx_records_boilid")
  @@index([canId], map: "idx_records_canid")
  @@index([conveyorId], map: "idx_records_conveyorid")
  @@index([doc_id], map: "idx_records_doc_id")
  @@index([doc_id, id, productId, boilId, conveyorId, apparatusId, canId, workshopId, plan, bbf, dm, createdAt, updatedAt], map: "idx_records_docid_cover")
  @@index([doc_id, id], map: "idx_records_docid_id")
  @@index([organic_base_id], map: "idx_records_organic_base_id")
  @@index([productId], map: "idx_records_productid")
  @@index([water_base_id], map: "idx_records_water_base_id")
}

model regulations {
  id                    Int             @id @default(autoincrement())
  product_id            Int?
  water_base_min_weight Decimal?        @db.Decimal
  water_base_max_weight Decimal?        @db.Decimal
  per_box               Int?
  box_per_row           Int?
  row_on_pallet         Int?
  gasket                String?         @db.VarChar(255)
  seal                  Boolean?
  technician_note       String?         @db.VarChar(255)
  packaging_note        String?         @db.VarChar(255)
  marking_sample_id     Int?
  createdAt             DateTime        @db.Timestamptz(6)
  updatedAt             DateTime        @db.Timestamptz(6)
  marking_sample        marking_sample? @relation(fields: [marking_sample_id], references: [id], onDelete: Restrict)
  products              products?       @relation(fields: [product_id], references: [id], onDelete: Cascade)
}

model roles {
  id          Int          @id @default(autoincrement())
  value       String       @unique @db.VarChar(255)
  description String       @unique @db.VarChar(255)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)
  user_roles  user_roles[]
}

model semi_products {
  id         Int       @id @default(autoincrement())
  record_id  Int?
  product_id Int?
  boil_id    Int?
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  boils      boils?    @relation(fields: [boil_id], references: [id], onDelete: Cascade)
  products   products? @relation(fields: [product_id], references: [id], onDelete: Cascade)
  records    records?  @relation(fields: [record_id], references: [id], onDelete: Cascade)

  @@index([boil_id], map: "idx_semi_products_boil_id")
  @@index([product_id], map: "idx_semi_products_product_id")
  @@index([record_id], map: "idx_semi_products_record_id")
}

model series {
  id       Int        @id @default(autoincrement())
  value    String     @unique @db.VarChar(255)
  products products[]
}

model tokens {
  id        Int      @id @default(autoincrement())
  userId    Int?
  token     String   @unique @db.VarChar(3000)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  users     users?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_tokens_user_id")
}











model user_roles {
  id     Int   @id @default(autoincrement())
  roleId Int
  userId Int
  roles  roles @relation(fields: [roleId], references: [id], onDelete: Cascade)
  users  users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roleId, userId])
  @@index([roleId], map: "idx_user_roles_role_id")
  @@index([userId], map: "idx_user_roles_user_id")
}

model user_settings {
  id       Int     @id @default(autoincrement())
  user_id  Int?    @unique
  plant_id Int?
  plants   plants? @relation(fields: [plant_id], references: [id], onDelete: Cascade)
  users    users?  @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model users {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(255)
  email         String         @unique @db.VarChar(255)
  password      String         @db.VarChar(255)
  banned        Boolean       @default(false)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)
  histories     histories[]
  tokens        tokens[]
  user_roles    user_roles[]
  user_settings user_settings?
}

model workshops {
  id      Int       @id @default(autoincrement())
  value   String    @unique @db.VarChar(255)
  records records[]
}
