{
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "incremental": true,
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "baseUrl": ".",
        "ignoreDeprecations": "6.0"
    },
    "include": [
        "src"
    ]
}