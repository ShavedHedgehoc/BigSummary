user nginx;
worker_processes auto;
pid /run/nginx.pid;

events {
    worker_connections 1024;
    multi_accept on;
}

http {

    sendfile on;
    tcp_nopush on;
    types_hash_max_size 2048;
    client_max_body_size 100M;

    default_type application/octet-stream;

    ssl_protocols TLSv1 TLSv1.1 TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    gzip on;
    # application
    # server {
    #     listen 80 default;
    #     location / {
    #         proxy_pass http://app:3000;
    #         proxy_pass_header Content-Type;
    #     }
    #     include /etc/nginx/mime.types;
    #     location /api {
    #         proxy_pass http://api:7000;
    #     }
    # }
    # Workstation
    # server {
    #     listen 3000 default;
    #     location / {
    #         proxy_pass http://workstation:3000;
    #     }
    #     location /api {
    #         proxy_pass http://api:7000;
    #     }
    # }
    server {
        listen ${WORKSTATION_PORT} default_server;
        location / {
            proxy_pass http://workstation:${WORKSTATION_PORT};
        }
        location /trpc_api {
            rewrite ^/trpc_api(/.*)$ /trpc$1 break;
            proxy_pass http://api:${API_PORT};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    server {
        listen ${DASH_PORT} default_server;
        location / {
            proxy_pass http://dash:${DASH_PORT};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
        location /trpc_api {
            rewrite ^/trpc_api(/.*)$ /trpc$1 break;
            proxy_pass http://api:${API_PORT};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
