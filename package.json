{
    "name": "repo",
    "version": "2.0.2",
    "private": true,
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "knip": "knip --no-config-hints",
        "db:generate": "pnpm --filter @repo/db-postgres --filter @repo/db-mssql generate",
        "api:dev": "pnpm --filter api_v2 dev",
        "monorepo:dev": "pnpm --filter \"./apps/**\" --parallel run dev",
        "build": "pnpm --filter \"./apps/**\" --parallel run build",
        "monorepo:lint": "pnpm --filter \"./apps/**\"  run lint",
        "monorepo:typecheck": "pnpm --filter \"./apps/**\"  run type-check",
        "monorepo:format": "prettier --write .",
        "monorepo:format:check": "prettier --check .",
        "test": "pnpm -r test",
        "pre-flight": "pnpm monorepo:format:check && pnpm monorepo:lint && pnpm monorepo:typecheck && pnpm knip && pnpm build"
    },
    "devDependencies": {
        "eslint-plugin-import": "^2.32.0",
        "knip": "^6.9.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.3"
    },
    "pnpm": {
        "overrides": {
            "@types/react": "^19.0.0",
            "@types/react-dom": "^19.0.0",
            "zod": "^4.4.2",
            "@trpc/server": "^11.0.0-rc.446",
            "@trpc/client": "^11.0.0-rc.446",
            "@trpc/react-query": "^11.0.0-rc.446",
            "@tanstack/react-query": "^5.0.0",
            "@nestjs/swagger": "11.4.7"
        }
    }
}
