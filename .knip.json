{
    "$schema": "https://unpkg.com",
    "ignore": [],
    "workspaces": {
        ".": {
            "ignore": [
                "api/**",
                "workstation/**",
                "application/**",
                "public_api/**",
                "public_api_2/**"
            ],
            "ignoreDependencies": []
        },
        "apps/api_v2": {
            "project": [
                "src/**/*.ts"
            ],
            "ignoreDependencies": [
                "superjson",
                "bcryptjs",
                "dotenv"
            ]
        },
        "apps/dash": {
            "entry": [
                "src/app/main.{ts,tsx}"
            ],
            "ignore": [
                "src/shared/ui/**"
            ],
            "project": [
                "src/**/*.{ts,tsx}"
            ],
            "ignoreDependencies": []
        },
        "packages/db/postgres": {
            "project": [
                "src/**/*.ts"
            ],
            "ignore": [
                "**/generated/**/*"
            ],
            "ignoreDependencies": [
                "@prisma/client"
            ]
        },
        "packages/db/mssql": {
            "project": [
                "src/**/*.ts"
            ],
            "ignore": [
                "**/generated/**/*"
            ],
            "ignoreDependencies": [
                "@prisma/client"
            ]
        },
        "packages/trpc": {
            "ignore": [],
            "ignoreDependencies": [
                "@types/express",
                "@types/express-serve-static-core",
                "zod"
            ]
        }
    }
}